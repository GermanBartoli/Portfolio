  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "^0.2.0",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@12.23.0"
}
