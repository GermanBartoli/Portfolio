  <dialog data-image-dialog class="project-image-dialog" aria-label="Imagen ampliada del proyecto">
    <div class="image-controls">
      <button type="button" data-zoom-out aria-label="Reducir zoom">−</button>
      <output aria-live="polite">100%</output>
      <button type="button" data-zoom-in aria-label="Aumentar zoom">+</button>
      <button type="button" data-image-fit>Ajustar</button>
      <button type="button" data-image-close>Cerrar ×</button>
    </div>
    <div data-image-viewport class="image-viewport" tabindex="0" aria-label="Imagen ampliada; desplazá para recorrerla"><img data-expanded-image alt="" /></div>
  </dialog>
