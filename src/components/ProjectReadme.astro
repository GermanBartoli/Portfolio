---
import { Content as GuiaGastos } from '../data/readmes/german-gastos.md';
import ProjectImageDialog from './ProjectImageDialog.astro';
interface Props { slug: string; title: string; privateRepo?: boolean; }
const { slug, title, privateRepo = false } = Astro.props;
const url = `https://github.com/GermanBartoli/${slug}#readme`;
---
<section data-project-readme={privateRepo ? undefined : slug} class="project-readme" aria-label={`Guía de ${title}`}>
  <header class="readme-header">
    <div><span class="eyebrow">DOCUMENTACIÓN DEL PROYECTO</span><h2>Guía de uso</h2></div>
    <a class="text-link" href={url} target="_blank" rel="noreferrer">Ver README en GitHub ↗</a>
  </header>
  {privateRepo && slug === 'german-gastos' ? <>
    <p class="readme-date">README publicado para consulta. El repositorio y la aplicación mantienen su acceso privado.</p>
    <div class="readme-content"><div class="markdown-body"><GuiaGastos /></div></div>
  </> : privateRepo ? <p class="readme-date">El repositorio y su README son privados. El enlace de GitHub requiere una cuenta autorizada; la aplicación también tiene acceso privado.</p> : <>
  <p class="readme-date" data-readme-status role="status">Cargando documentación desde GitHub…</p>
  <div class="readme-content" data-readme-content hidden></div>
  <button class="button button-outline" data-readme-retry hidden>Reintentar</button>
  <noscript><p>Para leer la guía, abrí el enlace al README de GitHub.</p></noscript>
  <ProjectImageDialog />
  </>}
</section>
<script>import "../scripts/readme";</script>
<style is:global>
  .project-readme { margin-top: 64px; min-width: 0; border-top: 1px solid var(--line); padding-top: 36px; }
  .readme-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .readme-header h2 { font-size: clamp(28px, 4vw, 42px); margin-top: 12px; }
  .readme-date { color: var(--muted); font-size: 12px; margin: 18px 0 28px; }
  .readme-content { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: clamp(18px, 4vw, 48px); overflow-wrap: anywhere; line-height: 1.75; }
  .readme-content .markdown-body { max-width: 960px; margin: auto; }
  .readme-content h1 { font-size: clamp(26px, 4vw, 40px); line-height: 1.25; margin: 0 0 24px; }
  .readme-content h2 { font-size: clamp(23px, 3vw, 30px); line-height: 1.35; margin: 36px 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .readme-content h3, .readme-content h4 { font-size: 20px; margin: 28px 0 14px; }
  .readme-content p, .readme-content ul, .readme-content ol, .readme-content pre, .readme-content table { margin: 16px 0; }
  .readme-content ul, .readme-content ol { padding-left: 25px; }
  .readme-content ul { list-style: disc; }
  .readme-content ol { list-style: decimal; }
  .readme-content li { margin: 6px 0; }
  .readme-content a { text-decoration: underline; text-underline-offset: 3px; }
  .readme-content img { max-width: 100%; height: auto; display: inline; vertical-align: middle; }
  .readme-content pre { padding: 20px; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; overflow-x: auto; white-space: pre; }
  .readme-content code { font-family: monospace; font-size: .88em; }
  .readme-content table { display: block; overflow-x: auto; border-collapse: collapse; }
  .readme-content th, .readme-content td { padding: 10px 14px; border: 1px solid var(--line); min-width: 120px; overflow-wrap: normal; }
  .readme-content blockquote { border-left: 3px solid var(--muted); padding-left: 20px; margin: 20px 0; }
  .readme-content .anchor { display: block; height: 0; overflow: hidden; }
  .readme-content .anchor svg { display: none; }
  .readme-content [id] { scroll-margin-top: 110px; }
  .readme-content summary { cursor: pointer; }
  .readme-empty { margin-top: 24px; color: var(--muted); }
  .readme-image-open { display: block; padding: 0; border: 0; background: transparent; max-width: 100%; cursor: zoom-in; }
  [data-primary-image] .readme-image-open { width: 100%; }
  .readme-image-open:focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; }
  .project-image-dialog { width: 96vw; max-width: 1600px; max-height: 94dvh; padding: 12px; overflow: hidden; }
  .project-image-dialog .image-controls { display: flex; gap: 8px; align-items: center; justify-content: flex-end; flex-wrap: wrap; margin-bottom: 12px; }
  .image-controls button { border: 1px solid var(--line); background: var(--panel); color: inherit; border-radius: 8px; min-width: 44px; min-height: 44px; padding: 8px 12px; cursor: pointer; }
  .image-controls button:disabled { opacity: .4; cursor: default; }
  .image-controls output { min-width: 48px; text-align: center; }
  .project-image-dialog .image-viewport { height: 74dvh; overflow: auto; overscroll-behavior: contain; padding: 12px; }
  .project-image-dialog .image-viewport img { display: block; max-width: none; max-height: none; height: auto; margin: auto; }
</style>
