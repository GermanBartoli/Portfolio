---
import type { Project } from '../data/projects';
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
---
<article class="project-card reveal" data-category={project.category}>
  <a class:list={['project-image', `visual-${project.slug.toLowerCase()}`]} href={`/proyectos/${project.slug}/`} aria-label={`Ver proyecto ${project.title}`}>
    {project.image ? <img src={project.image} alt={`${project.title}: ${project.imageNote || 'captura del proyecto'}`} loading="lazy" width="1000" height="650" transition:name={`image-${project.slug}`} /> : <div class="project-placeholder" aria-hidden="true"><span>{project.stack[0]}</span><strong>{project.title}</strong><small>ARCHIVO DE PROYECTOS</small></div>}
    <span class="image-corner">{String(index + 1).padStart(2, '0')}</span><span class="project-open">↗</span>
  </a>
  <div class="project-meta"><span>{project.category} <i> / </i> {project.year}</span><span>{project.stack.slice(0, 2).join(' + ')}</span></div>
  <h3><a href={`/proyectos/${project.slug}/`}>{project.title}</a></h3><p>{project.description}</p>
</article>
