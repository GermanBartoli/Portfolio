---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Presence from '../components/Presence.astro';
import Contact from '../components/Contact.astro';
import CodingMusic from '../components/CodingMusic.astro';
import Location from '../components/Location.astro';
import Activity from '../components/Activity.astro';
import FidelityGallery from '../components/FidelityGallery.astro';
import { projects } from '../data/projects';
import { profile, experience, education, videos } from '../data/profile';
---
<Layout>
  <section id="inicio" class="hero section-shell">
    <div class="hero-top"><span class="eyebrow"><i class="small-dot"></i> GERMAN BARTOLI / DESARROLLADOR</span><span class="hero-coordinate">CÓRDOBA, AR <span id="local-time"></span></span></div>
    <div class="hero-main">
      <div class="hero-copy"><h1><span>Ideas que</span><br /><span>se vuelven</span><br /><em>software.</em></h1><p>Me gusta entender cómo funcionan las cosas.<br />Y construir las que todavía no existen.</p><a class="button button-primary magnetic" href="#proyectos">Explorá mi trabajo <span>↘</span></a></div>
      <div class="hero-art hero-brand"><img src="/images/brand/german-bartoli.webp" alt="Logo de German Bartoli — Developer" width="800" height="800" fetchpriority="high" /></div>
    </div>
    <div class="hero-bottom"><span>DESARROLLO FULL STACK · WEB · EXTENSIONES</span><a href="#codex">Hay más abajo <span>↓</span></a></div>
  </section>
  <Activity />
  <section id="intro" class="intro section-shell"><span class="eyebrow">01 / LA CURIOSIDAD COMO PUNTO DE PARTIDA</span><h2 class="story-text">Del primer <span>«¿y si…?»</span><br />a algo que podés <em>usar.</em></h2><div class="intro-bottom"><span class="asterisk" aria-hidden="true">✳</span><p>Soy German, desarrollador de software y Técnico Universitario en Programación. Entre aplicaciones, extensiones y proyectos personales, convierto problemas cotidianos en herramientas concretas. Este espacio reúne lo que hago, lo que aprendo y lo que viene.</p></div></section>
  <section id="proyectos" class="projects section-shell">
    <div class="section-heading"><div><span class="eyebrow">02 / DEL CÓDIGO AL MUNDO REAL</span><h2>Trabajo <em>seleccionado.</em></h2></div><span class="section-count">{String(projects.length).padStart(2, '0')} PROYECTOS / 2022—2026</span></div>
    <div class="filters" role="group" aria-label="Filtrar proyectos">{['Todos', 'Web', 'Extensiones', 'Software'].map((category) => <button type="button" data-filter={category} aria-pressed={category === 'Todos'}>{category}<span>{category === 'Todos' ? projects.length : projects.filter(p => p.category === category).length}</span></button>)}</div>
    <div class="project-grid">{projects.filter(p => p.featured).map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <details class="project-archive"><summary>Los proyectos que me trajeron hasta acá <span>ARCHIVO / 08 <b>+</b></span></summary><div class="project-grid">{projects.filter(p => !p.featured).map((project, index) => <ProjectCard project={project} index={index + 7} />)}</div></details>
    <p id="filter-status" class="sr-only" role="status"></p>
    <a class="text-link" href={profile.github} target="_blank" rel="noreferrer">Más código y experimentos en GitHub ↗</a>
  </section>
  <section id="historia" class="history section-shell"><div class="history-heading"><span class="eyebrow">03 / NUNCA DEJAR DE APRENDER</span><h2>Un camino. Muchas <em>versiones.</em></h2><p>La formación dio el punto de partida.<br />La práctica y la curiosidad hacen el resto.</p><a class="text-link" href={profile.linkedin} target="_blank" rel="noreferrer">Conectemos en LinkedIn ↗</a></div><div class="timeline"><h3 class="timeline-group">EXPERIENCIA</h3>{experience.map(item => <article class="timeline-item reveal"><span class="timeline-dot"></span><span class="eyebrow">{item.date}</span><h3><a href={item.url} target="_blank" rel="noreferrer">{item.title} ↗</a></h3><h4>{item.role}</h4><p>{item.text}</p>{item.title === 'Fidelitytools' && <FidelityGallery />}</article>)}<h3 class="timeline-group">FORMACIÓN</h3>{education.map(item => <article class="timeline-item reveal"><span class="timeline-dot"></span><span class="eyebrow">{item.date}</span><h3>{item.title}</h3><a href={item.url} target="_blank" rel="noreferrer">{item.place} ↗</a></article>)}</div></section>
  <section id="tecnologias" class="toolbox section-shell"><div class="toolbox-sticky"><span class="eyebrow">04 / MI CAJA DE HERRAMIENTAS</span><h2>La tecnología al servicio<br />de <em>la idea.</em></h2><div class="tool-rail" tabindex="0" aria-label="Tecnologías, desplazamiento horizontal">{[['01', 'Backend', 'C# · .NET · Java · Node.js'], ['02', 'Frontend', 'TypeScript · JavaScript · HTML · CSS'], ['03', 'Datos', 'SQL Server · MySQL'], ['04', 'Construir y publicar', 'Git · GitHub · Cloudflare'], ['05', 'Explorar', 'Chrome Extensions · Lua · OBS']].map(([num, title, text]) => <article><span>{num} /</span><h3>{title}</h3><p>{text}</p><i aria-hidden="true">↗</i></article>)}</div><p class="rail-hint">Deslizá para explorar →</p></div></section>
  <section id="videos" class="videos section-shell"><div class="section-heading"><div><span class="eyebrow">05 / COMPARTIR TAMBIÉN ES APRENDER</span><h2>Ideas en <em>movimiento.</em></h2></div><p>Código, tecnología y los equipos<br />que hacen posibles las ideas.</p></div><div class="video-grid">{videos.map(video => <article class="video-card reveal"><button class="video-poster" data-video={video.id} aria-label={`Reproducir ${video.title}`}><img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt={`Miniatura del video ${video.title}`} loading="lazy" width="480" height="360" /><span class="play-icon">▶</span><span class="video-tag">VER VIDEO ↗</span></button><span class="eyebrow">{video.category}</span><h3>{video.title}</h3><p>{video.description}</p><a class="text-link" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noreferrer">Abrir en YouTube ↗</a></article>)}</div></section>
  <section id="ahora" class="now section-shell"><div class="now-copy"><span class="eyebrow">06 / DETRÁS DE LA PANTALLA</span><h2>También hay<br />vida entre<br /><em>los commits.</em></h2><p>Música de fondo, un juego abierto o una nueva idea. Una pequeña ventana a lo que estoy haciendo en este momento.</p><div class="now-note"><span class="small-dot"></span><span>Mi estado de Discord, en tiempo real.</span></div><a class="text-link" href={profile.wakatime} target="_blank" rel="noreferrer">Mi actividad de programación ↗</a></div><Presence /></section>
  <CodingMusic />
  <section id="contacto" class="contact section-shell"><div class="contact-copy"><span class="eyebrow">08 / EL PRÓXIMO PROYECTO</span><h2>¿Y si lo<br /><em>construimos?</em></h2><p>¿Una idea, una colaboración o simplemente ganas de conversar? Contame.</p><div class="contact-socials"><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div><span class="eyebrow contact-location">VILLA ALLENDE · CÓRDOBA · ARGENTINA</span></div><Contact /></section>
  <Location />
  <dialog id="video-dialog" aria-label="Reproductor de video"><button class="dialog-close" aria-label="Cerrar video">Cerrar ✕</button><div id="video-container"></div><p>Si YouTube no permite reproducirlo aquí, usá el enlace «Abrir en YouTube».</p></dialog>
</Layout>
