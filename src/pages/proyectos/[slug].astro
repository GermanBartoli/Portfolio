---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import ProjectImageDialog from '../../components/ProjectImageDialog.astro';
import ProjectReadme from '../../components/ProjectReadme.astro';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const next = projects[(projects.findIndex(p => p.slug === project.slug) + 1) % projects.length];
---
<Layout title={`${project.title} — German Bartoli`} description={project.description}>
  <article class="project-detail section-shell"><a class="text-link" href="/#proyectos">← Todos los proyectos</a><div class="detail-heading"><span class="eyebrow">{project.category} / {project.year}</span><h1>{project.title}</h1><p>{project.description}</p><div class="tag-list">{project.stack.map(tag => <span>{tag}</span>)}</div></div>{project.image && <figure data-primary-zoom><div data-primary-image><img src={project.image} alt={project.title} transition:name={`image-${project.slug}`} width="1400" height="900" /></div><ProjectImageDialog /><figcaption>{project.imageNote || 'Captura del proyecto'}</figcaption></figure>}<div class="detail-links"><a class="button button-outline" href={`https://github.com/GermanBartoli/${project.slug}`} target="_blank" rel="noreferrer">Explorar el código ↗</a>{project.website && <a class="button button-primary magnetic" href={project.website} target="_blank" rel="noreferrer">Visitar el sitio ↗</a>}</div><ProjectReadme slug={project.slug} title={project.title} /><a class="next-project" href={`/proyectos/${next.slug}/`}><span class="eyebrow">SEGUIR EXPLORANDO</span><h2>{next.title} ↗</h2></a></article>
</Layout>

<script>
  import { prepararZoom } from '../../scripts/projectImage';
  let active: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    active?.abort();
    const figure = document.querySelector<HTMLElement>('[data-primary-zoom]');
    if (!figure) return;
    active = new AbortController();
    void prepararZoom(figure, active.signal, '[data-primary-image]');
  });
  document.addEventListener('astro:before-swap', () => active?.abort());
</script>
