---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const next = projects[(projects.findIndex(p => p.slug === project.slug) + 1) % projects.length];
---
<Layout title={`${project.title} — German Bartoli`} description={project.description}>
  <article class="project-detail section-shell"><a class="text-link" href="/#proyectos">← Todos los proyectos</a><div class="detail-heading"><span class="eyebrow">{project.category} / {project.year}</span><h1>{project.title}</h1><p>{project.description}</p><div class="tag-list">{project.stack.map(tag => <span>{tag}</span>)}</div></div>{project.image && <figure><img src={project.image} alt={project.title} transition:name={`image-${project.slug}`} width="1400" height="900" /><figcaption>{project.imageNote || 'Captura del proyecto'}</figcaption></figure>}<div class="detail-links"><a class="button button-primary magnetic" href={`https://github.com/GermanBartoli/${project.slug}`} target="_blank" rel="noreferrer">Explorar el código ↗</a>{project.website && <a class="button button-outline" href={project.website} target="_blank" rel="noreferrer">Visitar el sitio ↗</a>}</div><p class="detail-note">El repositorio reúne el código, la documentación y los detalles de este proyecto. Los trabajos del archivo conservan sus enlaces originales.</p><a class="next-project" href={`/proyectos/${next.slug}/`}><span class="eyebrow">SEGUIR EXPLORANDO</span><h2>{next.title} ↗</h2></a></article>
</Layout>
