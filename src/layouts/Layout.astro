---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const sections = [['inicio', 'Inicio'], ['intro', 'Sobre mí'], ['proyectos', 'Proyectos'], ['historia', 'Mi recorrido'], ['tecnologias', 'Tecnologías'], ['videos', 'Videos'], ['ahora', 'Discord'], ['musica', 'Spotify'], ['contacto', 'Contacto'], ['ubicacion', 'Ubicación']];
const { title = 'German Bartoli — Software, ideas y un poco de curiosidad', description = 'Portfolio de German Bartoli. Desarrollo de software, proyectos web, extensiones y experimentos desde Córdoba, Argentina.' } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111311" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/social.png', Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="German Bartoli, inicio">gb<span>®</span></a>
      <nav class="section-nav" aria-label="Navegación principal">
        <div class="nav-inline">{sections.map(([id, label]) => <a href={`/#${id}`} data-section-link={id}>{label}</a>)}</div>
        <details class="nav-overflow">
          <summary aria-label="Mostrar secciones"><span class="nav-more-label">Más</span><span aria-hidden="true"> +</span></summary>
          <div class="nav-dropdown">{sections.map(([id, label]) => <a href={`/#${id}`} data-overflow-link={id}>{label}<span aria-hidden="true">↗</span></a>)}</div>
        </details>
      </nav>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer"><a class="wordmark" href="/">gb<span>®</span></a><p>Hecho con intención. Siempre en construcción.<br /><small>© {new Date().getFullYear()} German Bartoli · Córdoba, Argentina</small></p><a href="#contenido">Volver arriba ↑</a></footer>
    <a class="back-to-top" href="#contenido" aria-label="Volver arriba" title="Volver arriba">↑</a>
    <script>import '../scripts/interactions';</script>
  </body>
</html>
